APP_NAME="VertoAD API"
APP_ENV=local
APP_DEBUG=false
APP_KEY=def00000replace-with-defuse-ascii-safe-key
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC

DB_DRIVER=pdo_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vertoad
DB_USERNAME=vertoad
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DATABASE_URL=
TEST_DB_DATABASE=vertoad_test
PHINX_ENVIRONMENT=development

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DRIVER=auto
# Use REDIS_DRIVER=socket if the phpredis extension is unavailable and the managed Redis service is incompatible with Predis.
REDIS_PASSWORD=change-me-long-random-password
REDIS_PREFIX=vertoad:
REDIS_DATABASE=0
REDIS_TIMEOUT_SECONDS=5
REDIS_READ_TIMEOUT_SECONDS=5
REDIS_SERVING_EVENT_VISIBILITY_TIMEOUT_SECONDS=300
REDIS_SERVING_EVENT_RETENTION_SECONDS=604800
REDIS_DANGEROUS_COMMANDS_DISABLED=FLUSHALL,FLUSHDB,CONFIG
REDIS_AUTH_FAILURE_ALERTING_CONFIGURED=false

S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vertoad
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PATH_STYLE_ENDPOINT=true
R2_PUBLIC_BASE_URL=https://cdn.example.com

OAUTH_PRIVATE_KEY_PATH=storage/oauth/private.key
OAUTH_PUBLIC_KEY_PATH=storage/oauth/public.key
OAUTH_ENCRYPTION_KEY=replace-with-32-byte-random-string
OAUTH_AUTHORIZATION_URL=https://auth.example.com/oauth/authorize
OAUTH_TOKEN_URL=https://auth.example.com/oauth/token
OAUTH_CLIENT_ID=replace-with-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

CRON_API_TOKEN=replace-with-long-random-cron-token
CRON_API_ALLOWED_IPS=127.0.0.1,::1
CRON_LOCK_TTL_SECONDS=300
CRON_EVENT_CONSUME_BATCH_SIZE=500
CRON_AGGREGATE_STATISTICS_LOOKBACK_HOURS=24
CRON_AI_REVIEW_BATCH_SIZE=50
CRON_CONFIG_CACHE_TTL_SECONDS=300
CRON_EXPIRED_TOKEN_RETENTION_SECONDS=86400

WEBHOOK_SIGNING_SECRET=replace-with-webhook-hmac-secret
WEBHOOK_RETRY_BATCH_SIZE=50
WEBHOOK_HTTP_TIMEOUT_SECONDS=5

CLOUDFLARE_REAL_IP_HEADER=CF-Connecting-IP
# Required in staging/prod when the API is behind Cloudflare. Empty disables
# trusting forwarded real-IP headers and falls back to REMOTE_ADDR.
CLOUDFLARE_TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22

TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

SECURITY_RATE_LIMIT=60
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60

AI_REVIEW_BASE_URL=https://api.openai.com/v1
AI_REVIEW_API_KEY=replace-with-openai-compatible-api-key
AI_REVIEW_MODEL=gpt-4.1-mini
AI_REVIEW_PROMPT="Return strict JSON with risk_score, risk_labels, reasons, and recommendation for VertoAD creative policy review."
AI_REVIEW_TIMEOUT_SECONDS=60
AI_REVIEW_MAX_INPUT_TOKENS=12000
AI_REVIEW_MAX_OUTPUT_TOKENS=2000
AI_REVIEW_TEMPERATURE=0.2
