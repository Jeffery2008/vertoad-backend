{
  "name": "vertoad/backend",
  "description": "VertoAD Slim 4 API backend.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "8.4.22",
    "aws/aws-sdk-php": "^3.343",
    "doctrine/dbal": "^4.3",
    "james-heinrich/getid3": "v1.9.25",
    "league/oauth2-server": "^8.5",
    "monolog/monolog": "^3.9",
    "php-di/php-di": "^7.0",
    "predis/predis": "2.4",
    "robmorgan/phinx": "^0.16",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2"
  },
  "autoload": {
    "psr-4": {
      "VertoAD\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VertoAD\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group redis-integration --fail-on-skipped",
    "test:coverage": "php scripts/coverage-gate.php",
    "test:redis-integration": "phpunit --group redis-integration --fail-on-skipped --display-skipped",
    "serve": "php -S 127.0.0.1:8080 -t public",
    "migrate": "phinx migrate",
    "migrate:rollback": "phinx rollback",
    "openapi:check": "php scripts/openapi-check.php docs/openapi.yaml"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.22"
    }
  }
}
