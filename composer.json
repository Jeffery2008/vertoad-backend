{
  "name": "vertoad/backend",
  "description": "VertoAD Slim 4 API backend.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "8.4.22",
    "aws/aws-sdk-php": "^3.343",
    "doctrine/dbal": "^4.3",
    "james-heinrich/getid3": "v1.9.25",
    "league/oauth2-server": "^8.5",
    "monolog/monolog": "^3.9",
    "php-di/php-di": "^7.0",
    "predis/predis": "2.4",
    "robmorgan/phinx": "^0.16",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/yaml": "^8.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2"
  },
  "autoload": {
    "psr-4": {
      "VertoAD\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VertoAD\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group redis-integration --exclude-group mysql-install-rehearsal --exclude-group external-tools-integration --fail-on-skipped",
    "test:coverage": "php scripts/coverage-gate.php",
    "test:commercial-lifecycle-acceptance": "phpunit tests/Acceptance/CommercialLifecycleAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:mysql-cpm-billing-rehearsal": "@php tests/Billing/mysql-cpm-billing-rehearsal.php",
    "rehearse:mysql-install": "@php tests/Install/mysql-install-rehearsal.php",
    "test:mysql-install-rehearsal": "phpunit tests/Install/MysqlInstallRehearsalContractTest.php --fail-on-skipped --display-skipped",
    "test:mysql-oauth-rehearsal": "@php tests/OAuth/mysql-refresh-token-family-rehearsal.php",
    "test:mysql-webhook-outbox-rehearsal": "@php tests/Webhooks/mysql-webhook-outbox-rehearsal.php",
    "test:external-tools-integration": "phpunit tests/Integration/ExternalTools --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:archive-cold-query-acceptance": "phpunit tests/Acceptance/ArchiveColdQueryAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:presigned-asset-upload-acceptance": "phpunit tests/Acceptance/PresignedAssetUploadAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:attribution-browser-acceptance": "phpunit tests/Acceptance/AttributionBrowserAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:redis-backlog-acceptance": "phpunit tests/Acceptance/RedisBacklogDrainAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:error-operations-dashboard-acceptance": "phpunit tests/Acceptance/ErrorOperationsDashboardAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:cloudflare-real-ip-acceptance": "phpunit tests/Acceptance/CloudflareRealIpAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "test:serving-load-acceptance": "phpunit tests/Load/ServingLoadAcceptanceTest.php --fail-on-skipped --fail-on-warning --fail-on-risky",
    "rehearse:serving-load": "@php scripts/serving-load-rehearsal.php",
    "test:mysql-partition-rehearsal": "php scripts/mysql-partition-rehearsal.php --environment=testing --reset-database",
    "test:mysql-partition-query-rehearsal": "@php scripts/mysql-partition-query-rehearsal.php --execute",
    "test:redis-integration": "phpunit --group redis-integration --fail-on-skipped --display-skipped",
    "redis:readiness": "php scripts/redis-readiness.php",
    "s3:readiness": "php scripts/s3-readiness.php",
    "serve": "php -S 127.0.0.1:8080 -t public",
    "migrate": "phinx migrate",
    "migrate:rollback": "phinx rollback",
    "openapi:check": "php scripts/openapi-check.php docs/openapi.yaml"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.22"
    }
  }
}
